# Copy with: cp .env.example .env  (.env is gitignored)

# --- stage 06: contract-graph -------------------------------------------------
# Where paused reviews live. `docker compose up` provisions exactly this.
CONTRACT_DB_DSN=postgresql://contract:contract@localhost:5432/contract?sslmode=disable
# Host port for the compose Postgres. Change it when 5432 is already taken;
# a local Postgres on the same port answers with an authentication error that
# looks like a bug in this repo.
CONTRACT_DB_PORT=5432
# `postgres` (default) or `sqlite`, for running the service with no database.
CONTRACT_CHECKPOINTER=postgres
CONTRACT_DB_PATH=contract.sqlite3
# The directory a document URI is confined to.
CONTRACT_DOCUMENT_ROOT=fixtures
# The fake CRM's store. Deliberately durable; see contract/sinks.py.
CONTRACT_CRM_DB=.aimai-crm.sqlite3

# --- providers ---------------------------------------------------------------
# Every test and every script runs without these, against the rule-based
# reviewer. They are needed only to reproduce the tables with a real model.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
